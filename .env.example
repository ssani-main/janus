# Copy this file to .env and fill in the values (cp .env.example .env).
# src/config.js reads these directly from process.env.

# Port the Node process listens on (Caddy reverse-proxies to this).
PORT=3000

# Interface Node binds to. Keep this on loopback -- Caddy is the only thing
# that should ever talk to this process directly.
BIND_HOST=127.0.0.1

# Phase 1: the domain this gateway is served on. Tenant keys are derived
# from the leftmost subdomain label, e.g. https://0000<key>.<BASE_DOMAIN>/.
# REQUIRED -- the process fails fast if unset. Must match the domain(s)
# configured in Caddyfile (gateway.example.com + *.gateway.example.com).
BASE_DOMAIN=gateway.example.com

# Optional/legacy debug override left over from Phase 0, when this gateway
# proxied every request to a single hardcoded key regardless of Host. No
# longer required or used by the normal request path (Phase 1 derives the
# key from the request Host header instead) -- leave unset unless you have
# a specific debugging reason to hardcode one. Must be a "0000..." (public)
# key; "s000..." (secure/seed) keys are rejected.
TARGET_KEY=0000your52characterz32keygoeshereplaceholderxxxxxxxxxxxx

# Tier 0 (trust transparency): optional commit SHA of the code actually
# running, published on /healthz so anyone can compare this deploy against
# the public repo. Entirely optional -- leave unset if you don't want to
# publish one; the process boots fine either way. If set, must be a 7-40
# character hex string (a real or abbreviated git SHA) -- the process fails
# fast at startup otherwise. Typically set at deploy time, e.g.:
#   JANUS_COMMIT=$(git rev-parse HEAD)
JANUS_COMMIT=

# Local TCP port range reserved for tunnel backends (one port per distinct
# live key). Keep this range free of other services on the box.
TUNNEL_PORT_MIN=20000
TUNNEL_PORT_MAX=20999

# How many DISTINCT local ports a single cold create will try before giving
# up with a 502. A port handed out by the pool is only reserved in-process,
# so anything else on the box already bound to it makes the real listen()
# fail (EADDRINUSE); the tunnel manager then retries immediately onto the
# next pool port -- no backoff, since bind contention is not a dead backend.
# This bounds that loop so a heavily contended pool can't turn one request
# into an unbounded scan. Raise it only if the port range genuinely overlaps
# other software on the box -- the real fix for that is a dedicated range.
# Note it multiplies into the cold-create worst case bounded by
# ENSURE_TUNNEL_TIMEOUT_MS below. Must be >= 1.
MAX_PORT_ATTEMPTS=5

# How long to wait for a holesail-client connect() + liveness probe before
# giving up and returning 502.
CONNECT_TIMEOUT_MS=8000

# How long a tunnel may sit with no proxied requests before the sweeper
# tears it down (releases its port + HyperDHT node). Default 15 minutes.
IDLE_TTL_MS=900000

# Hard cap on concurrently-live tunnels. Phase 0 only ever needs 1, but the
# cap is enforced from day one since TunnelManager is built for Phase 1's
# multi-key pool.
#
# NOTE this bounds tunnels that have FINISHED connecting -- it is checked
# against the live tunnel map, and a record only lands there after a
# successful connect. It says nothing about how many cold creates are in
# flight at once; that is MAX_CONCURRENT_CREATES below.
MAX_TUNNELS=50

# Cap on cold creates running CONCURRENTLY, process-wide.
#
# Because MAX_TUNNELS only bounds finished tunnels (see above), and the
# tunnel manager's in-flight dedupe only covers concurrent creates for the
# SAME key, the only throttle on the expensive path used to be the per-IP
# RATE_MAX_NEW_TUNNELS -- an effective ceiling of 10 x (number of distinct
# client IPs), i.e. unbounded in practice. Each in-flight create holds a
# HolesailClient, and each of those is a HyperDHT node with a UDP socket, for
# up to ENSURE_TUNNEL_TIMEOUT_MS. Enough of them at once drives the process
# into its systemd MemoryMax, which restarts it and drops every live tenant:
# a traffic burst becomes an OOM restart loop instead of backpressure.
#
# 8 is deliberately well below MAX_TUNNELS -- cold creates are the expensive,
# bursty operation, while serving already-connected tunnels is cheap. Watch
# janus_creates_queued in /metrics: sustained nonzero means this is your
# bottleneck, and raising MAX_TUNNELS while creates queue accomplishes
# nothing. Must be >= 1.
MAX_CONCURRENT_CREATES=8

# How many cold creates may WAIT for a slot before further ones are rejected
# outright with 503 + Retry-After. An unbounded queue only moves the problem:
# visitors would each sit out the full ENSURE_TUNNEL_TIMEOUT_MS rather than
# being told quickly to come back. 0 disables queueing entirely (anything
# past MAX_CONCURRENT_CREATES fast-fails). Must be >= 0.
MAX_CREATE_QUEUE=64

# How long a local tunnel port abandoned by a TIMED-OUT connect is held out
# of the pool before it may be handed out again.
#
# holesail-client's internal net.Server can call listen() AFTER our connect
# timeout has already fired (its server reference is only set following an
# internal DHT round trip). If that late listen() lands on a port we have
# since reissued to another attempt, the resulting EADDRINUSE arrives with no
# in-flight attempt registered to claim it -- and the process-wide
# uncaughtException guard in src/tunnel-manager.js then correctly classifies
# it as a real unhandled bug and lets it crash the gateway. systemd restarts
# in ~2s, but every live tunnel dies with it. The trigger is exactly the
# condition DEPLOY.md's preflight warns about: filtered outbound UDP makes
# HyperDHT connects time out en masse.
#
# Holding the port out of circulation means a late bind usually has nothing
# to collide with; the guard separately absorbs a late EADDRINUSE for any
# still-quarantined port, so both halves must fail before a crash is
# possible. Only connect TIMEOUTS quarantine -- every other failure either
# already failed its bind or completed it. 0 disables. Should be at least
# CONNECT_TIMEOUT_MS; a smaller value logs a warning at startup.
PORT_QUARANTINE_MS=15000

# --- Phase 3: Open Sharing tier ---------------------------------------

# Legal identity fields shown on /impressum and (abuse contact) on /terms
# and the apex footer. All optional -- DO NOT put placeholder/fake data
# here. Any field left unset renders a clearly-marked "NOT CONFIGURED"
# warning on the page instead of silently omitting it. Fill these in with
# your real details before operating this gateway for anyone but yourself;
# depending on your jurisdiction an Impressum/legal notice may be a legal
# requirement for operating a public-facing service.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=

# Abuse contact shown on /terms and the apex footer. Defaults to
# OPERATOR_EMAIL if unset -- set separately if you want a distinct
# abuse@ / security@ address.
ABUSE_EMAIL=

# Operator kill-switch admin API (see README "Phase 3" section for curl
# examples). Unset (default) DISABLES /_admin/* entirely (404s). Set this
# to a long random secret to enable it -- treat it like a password; it
# grants the ability to list every live tunnel and kill/block any key.
# Security fix S8: when set, must be at least 16 characters -- the process
# fails fast at startup otherwise. A short/guessable admin token is
# brute-forceable; generate a long random value (e.g. `openssl rand -hex 32`).
ADMIN_TOKEN=

# Whether to trust the X-Forwarded-For header for per-IP rate limiting.
# Only set this to true (the default) when the gateway is ONLY reachable
# through a proxy you control (e.g. Caddy per Caddyfile) that sets/
# overwrites X-Forwarded-For itself -- otherwise clients can spoof this
# header to dodge or frame other IPs for the rate limit. Set to false (or
# "0") if the Node process is ever exposed directly.
TRUST_PROXY=true

# Security audit S2: number of trusted reverse proxies (e.g. Caddy) in front
# of this gateway. Only relevant when TRUST_PROXY is true. Caddy's
# reverse_proxy APPENDS to X-Forwarded-For rather than replacing it, so the
# leftmost entry is client-controlled (spoofable) while the rightmost N
# entries are appended by trusted hops -- clientIp() reads the XFF entry this
# many positions from the RIGHT, so client-spoofed XFF entries can't bypass
# per-IP rate limits. Default 1 (a single Caddy in front of Node, per
# Caddyfile). Increase only if you add more trusted proxy hops in front of
# Caddy.
TRUSTED_PROXY_HOPS=1

# Per-IP rate limiting: fixed window, two independent budgets per IP per
# window -- overall requests, and separately, NEW (cold) tunnel creations
# (the expensive path: HolesailClient connect + liveness probe).
RATE_WINDOW_MS=60000
RATE_MAX_REQUESTS=120
RATE_MAX_NEW_TUNNELS=10

# --- Milestone 1: persistent store --------------------------------------

# Path to the JSON file backing the persistent store (blocklist, named
# aliases, dashboard passwords). Survives restarts. Relative paths are
# resolved against the process's working directory.
STORE_PATH=./janus-data.json

# --- Milestone 1, Feature 3/4: sessions (per-key password gate, dashboard) --

# Secret used to sign/verify session cookies. Optional -- if left unset, the
# process generates a random secret at boot and logs a warning that sessions
# won't survive a restart or work across multiple processes (e.g. behind a
# load balancer). Set this to a long random value for production so
# passworded-key sessions and admin dashboard logins survive restarts.
SESSION_SECRET=

# How long a signed session cookie stays valid, in milliseconds. Default 7
# days.
SESSION_TTL_MS=604800000

# Whether session cookies get the Secure attribute (only sent over HTTPS).
# Must be true (the default) in any deployment served over TLS -- only set
# to false for local HTTP-only testing.
COOKIE_SECURE=true

# How long an admin dashboard login (cookie session, distinct from the
# bearer-token JSON API) stays valid, in milliseconds. Default 12 hours.
# Rotating ADMIN_TOKEN immediately invalidates any outstanding admin
# session cookies.
ADMIN_SESSION_TTL_MS=43200000

# Security fix S8: per-IP login-attempt lockout for POST /_admin/login.
# ADMIN_LOGIN_MAX_FAILS is the number of consecutive wrong-token attempts
# from one IP before it starts getting locked out; ADMIN_LOGIN_LOCKOUT_MS is
# the base lockout duration in milliseconds -- each additional failure past
# the threshold doubles the lockout (capped at 2^6x), so a persistent
# attacker faces a growing delay, not a fixed one. A correct login clears an
# IP's failure count. Defaults: 5 failures / 60000ms (60s) base lockout.
ADMIN_LOGIN_MAX_FAILS=5
ADMIN_LOGIN_LOCKOUT_MS=60000

# --- Milestone 2a: observability -----------------------------------------

# Whether to emit a JSON line per request to stdout (ts, level, msg, keyHash,
# method, path, status, durMs, bytes, ip -- never the raw key). Off by
# default -- high volume; opt in explicitly. Set to true (or "1") to enable.
LOG_REQUESTS=false

# --- Milestone 2c: circuit breaker + reconnect ---------------------------

# Consecutive cold-create (or reactive proxy-error) connect failures for a
# keyHash before its circuit opens. Once open, further cold creates for that
# key fast-fail with 503 + Retry-After instead of paying for a DHT round
# trip against a backend already known to be down. A cached, currently-
# healthy tunnel is never affected by an open circuit.
#
# Counted per FAILED REQUEST, not per connect attempt: one cold create that
# exhausts its whole RECONNECT_MAX_ATTEMPTS chain still contributes exactly
# one failure here. The two knobs are therefore independent -- raising
# RECONNECT_MAX_ATTEMPTS does not make the breaker more trigger-happy.
# A single success (cold create or proxied response) resets the count to
# zero, so failures must be genuinely consecutive to trip it.
#
# The default dropped from 5 to 2 when the counting was corrected: a whole
# cold-create chain now counts once, where it used to count once per
# reconnect attempt (~4x). At 5 a dead backend would absorb five full chains
# -- each up to ENSURE_TUNNEL_TIMEOUT_MS of DHT work -- before the breaker
# protected anything; 2 preserves roughly the old effective aggressiveness.
# Raise it if you see legitimate backends being fast-failed after transient
# blips; lower it only if you are certain a backend is genuinely down.
CIRCUIT_FAILURE_THRESHOLD=2

# How long a circuit stays open once it trips, in milliseconds.
CIRCUIT_COOLDOWN_MS=30000

# How many extra reconnect attempts are made (with exponential backoff +
# jitter) after the first cold-create attempt fails, before giving up and
# returning 502. Default 3 (up to 4 total attempts: 1 initial + 3
# reconnects).
RECONNECT_MAX_ATTEMPTS=3

# Base delay for the reconnect backoff, in milliseconds
# (RECONNECT_BASE_DELAY_MS * 2^attempt, capped at RECONNECT_MAX_DELAY_MS,
# with jitter applied so concurrent tunnels to the same dead backend don't
# retry in lockstep).
RECONNECT_BASE_DELAY_MS=250

# Cap on the reconnect backoff delay, in milliseconds.
RECONNECT_MAX_DELAY_MS=5000

# --- Milestone 2d: health probing + offline page -------------------------

# How often the periodic health probe checks every cached tunnel's local
# port for liveness, in milliseconds. Independent of the 60s idle sweeper
# (which only evicts idle tunnels and expired circuit entries). Default 30s.
HEALTH_PROBE_INTERVAL_MS=30000

# Per-probe connect timeout, in milliseconds. Must be well under
# HEALTH_PROBE_INTERVAL_MS -- the process fails fast at startup otherwise, so
# a probe can never outlive its own interval and stack up behind the next
# tick. Default 2s.
HEALTH_PROBE_TIMEOUT_MS=2000

# How many CONSECUTIVE failed liveness probes it takes before a cached tunnel
# is marked unhealthy and destroyed (the next request then cold-creates a
# fresh one through the normal backoff + circuit-breaker path). Effectively
# the "how twitchy is probe-driven eviction" dial, and the asymmetric half of
# the open-by-default trade-off: N consecutive failures to give up, but a
# SINGLE successful probe resets the streak immediately -- staying falsely
# unhealthy after a backend recovers is the costlier mistake. 1 evicts on any
# single blip (a momentary GC pause in the backend is enough); higher values
# tolerate more consecutive misses at the cost of serving a dead tunnel for
# longer. Must be >= 1. Default 2.
HEALTH_PROBE_UNHEALTHY_STREAK=2

# How long proxy.web() waits for the tunneled backend to respond before
# http-proxy aborts the request and serves the offline page (502). This is an
# IDLE-socket timeout, not a hard cap on total response duration -- a
# backend that is merely slow but keeps sending/receiving data is not cut
# off by this. Applies ONLY to plain HTTP proxying; it never affects
# websocket upgrades (a long-lived websocket is not subject to this timeout
# at all). Default 30s.
PROXY_TIMEOUT_MS=30000

# --- Security review (FIX 2): overall ensureTunnel() deadline ------------

# Wall-clock cap on the ENTIRE cold-create path for a single ensureTunnel()
# call -- the reconnect loop, the port-collision retry loop nested inside it,
# every per-attempt connect timeout, and every backoff sleep between
# reconnects, all together. Each of those is individually bounded, but their
# product isn't (worst case ~175s with the defaults above), and nothing else
# caps it while a visitor's HTTP request sits there waiting. Must be strictly
# greater than CONNECT_TIMEOUT_MS -- the process fails fast at startup
# otherwise. Default 45s: comfortably above a normal successful cold create,
# far below the worst case.
ENSURE_TUNNEL_TIMEOUT_MS=45000

# --- Security audit S3: websocket tunnel-pinning DoS mitigation -----------

# Max number of DISTINCT tunnel slots websockets may pin at once. A
# websocket to a key that's ALREADY ws-pinned is always allowed and does not
# consume an extra slot -- only lighting up a brand-new ws slot counts
# against this cap, so a legitimate app with many connections to ONE key is
# unaffected. Must be strictly LESS than MAX_TUNNELS (the process fails fast
# at startup otherwise) -- HTTP visitors must always have at least one slot
# of headroom, or a bunch of long-lived/hung websockets could pin every slot
# forever and starve plain HTTP requests with CapacityError. Default ~60% of
# MAX_TUNNELS.
WS_MAX_SLOTS=30

# Max concurrent websocket upgrades a single client IP may hold at once,
# independent of WS_MAX_SLOTS above -- bounds a single client/attacker from
# using up the entire ws slot budget by itself. Default 16.
WS_MAX_PER_IP=16

# How long a websocket connection may sit idle (no data read OR written)
# before it is forcibly closed, in milliseconds, via socket.setTimeout() --
# which Node refreshes on both read and write, so an actively heartbeating
# or server-pushing websocket is never affected; only a genuinely silent one
# times out. Closing it releases its tunnel slot so the idle/capacity
# reclaim paths can work again. Default 3600000 (1 hour); 0 disables (opt
# out for legitimately silent long-lived websockets).
WS_IDLE_TIMEOUT_MS=3600000
