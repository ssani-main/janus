# Janus - Caddy front door (TEMPLATE)
#
# Copy to `Caddyfile`, replace the placeholders, and deploy that copy. The
# real `Caddyfile` is gitignored so a live host's domain and provider config
# never land in version control:
#
#   cp Caddyfile.example Caddyfile
#   $EDITOR Caddyfile
#   sudo cp Caddyfile /etc/caddy/Caddyfile
#
# This terminates TLS ONLY. All routing / tunnel logic lives in the Node
# process at 127.0.0.1:3000 (see src/server.js).
#
# Prerequisites:
#   1. A wildcard cert for *.gw.example.com needs DNS-01 issuance (HTTP-01
#      cannot prove ownership of a wildcard name). Stock Caddy ships with NO
#      DNS provider plugins -- they are compiled in, not loaded at runtime --
#      so build one that has yours:
#        xcaddy build --with github.com/caddy-dns/<provider>
#      See https://github.com/caddy-dns for the full list (cloudflare,
#      route53, digitalocean, porkbun, desec, ...).
#   2. Wildcard DNS records pointed at this VPS:
#        gw.example.com     A/AAAA  <vps-ip>
#        *.gw.example.com   A/AAAA  <vps-ip>
#   3. An API token for your DNS provider with permission to create the
#      DNS-01 TXT challenge record, in an env var Caddy can read. Prefer a
#      systemd drop-in (`systemctl edit caddy`) over a world-readable file.
#
# Provider gotcha worth knowing: some registrars gate API access PER DOMAIN.
# Porkbun, for one, ships it OFF by default -- the domain must have "API
# ACCESS" switched on in its control panel or every DNS-01 challenge fails
# with an error that looks nothing like a permissions problem. Check your
# provider's equivalent before debugging Caddy.
#
# TLD gotcha: .dev and .app are HSTS-preloaded in full, so browsers refuse
# plain HTTP for those names with NO click-through override. Under such a
# TLD, a failed cert issuance makes the gateway unreachable rather than
# merely insecure -- watch `journalctl -u caddy -f` until certs actually
# issue before sharing any link.

# Global options.
{
	servers {
		timeouts {
			# Slowloris guard: a client that opens a connection and dribbles
			# request headers forever costs a connection slot on both Caddy and
			# Node for as long as it likes. Headers have no legitimate reason to
			# take more than a few seconds, so this is safe to bound tightly.
			read_header 10s
		}
	}

	# DELIBERATELY NOT SET, and worth understanding before you add them:
	#
	#   read_body  -- would also cap slow request BODIES, but a tenant backend
	#                 may legitimately receive a large upload over a slow link.
	#   write      -- caps how long a response may take to write. A tenant
	#                 serving big files, SSE, or a long-poll would be cut off
	#                 mid-response.
	#   idle       -- affects keep-alive connections; too low interacts badly
	#                 with the long-lived websockets this gateway supports on
	#                 purpose (see WS_IDLE_TIMEOUT_MS in .env.example, which is
	#                 the right knob for that job -- it refreshes on read AND
	#                 write, so it only reaps genuinely silent sockets).
	#
	# Tenant traffic is arbitrary third-party traffic. Prefer bounding it in
	# Node, where the limits are tenant-aware, over blunt proxy-wide timeouts.
}

# These two domains must match BASE_DOMAIN in .env (gw.example.com) and its
# "www." + wildcard subdomain forms -- src/routing.js treats BASE_DOMAIN and
# www.<BASE_DOMAIN> as the apex, and everything else under *.gw.example.com
# as a tenant key subdomain.
gw.example.com, *.gw.example.com {
	# Compress responses. Saves real bandwidth for real visitors on the apex,
	# guide and login pages, which embed ~33KB of base64 font each.
	#
	# IMPORTANT -- this is NOT a defence against egress amplification, and must
	# not be mistaken for one: the CALLER chooses the encoding. Anyone sending
	# `Accept-Encoding: identity` gets the full uncompressed body regardless of
	# what is configured here. The actual mitigation is that src/pages.js
	# serves errorPage/offlinePage/rateLimitPage WITHOUT the embedded fonts, so
	# the responses an anonymous caller can force us to emit in bulk are small
	# at the source. Keep it that way; see the LEAN_STYLE comment there.
	encode zstd gzip

	tls {
		# Configure the DNS-01 provider + API token env for whichever plugin
		# you built Caddy with. Examples:
		#
		#   dns cloudflare {env.CF_API_TOKEN}
		#
		#   dns route53
		#
		#   dns porkbun {
		#     api_key {env.PORKBUN_API_KEY}
		#     api_secret_key {env.PORKBUN_API_SECRET_KEY}
		#   }
		#
		# See the provider plugin's README for its exact directive/env vars.
		dns <PROVIDER>
	}

	# header_up Host {host} is required: Node's Phase 1 routing
	# (src/routing.js) derives the tenant key from this Host header, so it
	# must reach 127.0.0.1:3000 unmodified (the real public subdomain, not
	# an internal name).
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		# Security audit S2: OVERWRITE X-Forwarded-For with the real remote
		# host instead of appending to whatever the client sent. Without this,
		# a client-supplied X-Forwarded-For survives to Node, and since
		# src/server.js's clientIp() (with TRUST_PROXY) trusts it, a client
		# could prepend a fake entry to dodge/frame another IP's rate limit.
		header_up X-Forwarded-For {remote_host}
	}

	# OPTIONAL: shed abusive traffic at the proxy, before it reaches Node.
	#
	# Node already rate-limits per IP (RATE_WINDOW_MS / RATE_MAX_REQUESTS /
	# RATE_MAX_NEW_TUNNELS in .env), and that limiter is the tenant-aware one
	# -- it distinguishes a cheap cached-tunnel request from an expensive cold
	# create, which Caddy cannot. This block is purely defence in depth: it
	# stops a flood from costing Node an event-loop turn at all.
	#
	# Requires a PLUGIN -- rate_limit is not built into stock Caddy. You are
	# already building with xcaddy for the DNS provider, so add it there:
	#
	#   xcaddy build \
	#     --with github.com/caddy-dns/<provider> \
	#     --with github.com/mholt/caddy-ratelimit
	#
	# Verify the directive syntax against that plugin's current README before
	# deploying (https://github.com/mholt/caddy-ratelimit) -- it is a
	# third-party module and its config shape is not covered by Caddy's
	# compatibility promise. Then `caddy validate --config /etc/caddy/Caddyfile`
	# before reloading; a Caddyfile that fails to parse takes the whole site
	# down, and under an HSTS-preloaded TLD that means unreachable, not
	# degraded.
	#
	# rate_limit {
	# 	zone per_ip {
	# 		key    {remote_host}
	# 		events 300
	# 		window 1m
	# 	}
	# }

	# NOT SET, deliberately: `request_body { max_size ... }`. It would bound
	# upload size, but tenant backends are arbitrary third-party apps and some
	# legitimately accept large uploads. Set it only if you know every tenant
	# you host can live with the cap.
}
