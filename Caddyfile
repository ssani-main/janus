# Janus - Caddy front door
#
# This terminates TLS ONLY. All routing / tunnel logic lives in the Node
# process at 127.0.0.1:3000 (see src/server.js).
#
# Configured for BASE_DOMAIN=janus.ssani.dev on Porkbun DNS. To deploy under a
# different domain/provider, replace both hostnames below and swap the `dns`
# line for your provider's plugin (see https://github.com/caddy-dns).
#
# Prerequisites:
#   1. A wildcard cert for *.janus.ssani.dev needs DNS-01 issuance (HTTP-01
#      cannot prove ownership of a wildcard name). Stock Caddy has no DNS
#      provider plugins compiled in, so build one that does:
#        xcaddy build --with github.com/caddy-dns/porkbun
#   2. Wildcard DNS records pointed at this VPS:
#        janus.ssani.dev     A/AAAA  <vps-ip>
#        *.janus.ssani.dev   A/AAAA  <vps-ip>
#   3. Porkbun API credentials, exported where Caddy can read them (see
#      DEPLOY.md section 2 for the systemd override that does this):
#        PORKBUN_API_KEY=pk1_...
#        PORKBUN_API_SECRET_KEY=sk1_...
#      IMPORTANT: Porkbun disables API access PER DOMAIN by default. In the
#      Porkbun control panel, open ssani.dev -> Details and switch "API
#      ACCESS" on, or every DNS-01 challenge fails with a permissions error
#      that looks nothing like a permissions error.
#
# NOTE on .dev: the entire .dev TLD is on the HSTS preload list, so every
# browser refuses plain HTTP for these names with NO click-through override.
# If cert issuance fails, the gateway is not merely "insecure" -- it is
# unreachable. Confirm `journalctl -u caddy -f` shows certs actually issued
# before sharing any link.

# These two domains must match BASE_DOMAIN in .env (janus.ssani.dev) and its
# "www." + wildcard subdomain forms -- src/routing.js treats BASE_DOMAIN and
# www.<BASE_DOMAIN> as the apex, and everything else under *.janus.ssani.dev
# as a tenant key subdomain.
janus.ssani.dev, *.janus.ssani.dev {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_API_SECRET_KEY}
		}
	}

	# header_up Host {host} is required: Node's Phase 1 routing
	# (src/routing.js) derives the tenant key from this Host header, so it
	# must reach 127.0.0.1:3000 unmodified (the real public subdomain, not
	# an internal name).
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		# Security audit S2: OVERWRITE X-Forwarded-For with the real remote
		# host instead of appending to whatever the client sent. Without this,
		# a client-supplied X-Forwarded-For survives to Node, and since
		# src/server.js's clientIp() (with TRUST_PROXY) trusts it, a client
		# could prepend a fake entry to dodge/frame another IP's rate limit.
		header_up X-Forwarded-For {remote_host}
	}
}
